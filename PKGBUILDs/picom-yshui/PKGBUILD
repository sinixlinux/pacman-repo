pkgname=picom-yshui
pkgver=13
pkgrel=1
pkgdesc="A lightweight compositor for X11 (yshui fork)"
arch=('x86_64')
url="https://github.com/yshui/picom"
license=('MIT')
depends=('libx11' 'libxcb' 'libconfig' 'libev' 'pcre2' 'pixman' 'libdbus')
makedepends=('git' 'meson' 'ninja')
source=("git+https://github.com/yshui/picom.git")
sha256sums=('SKIP')

pkgver() {
    cd picom
    git describe --tags --long | sed 's/^v//;s/-\([0-9]*\)-g.*$/.\1/'
}

build() {
    cd picom

    meson setup build \
        --prefix=/usr \
        --buildtype=plain

    meson compile -C build
}

package() {
    cd picom

    DESTDIR="$pkgdir" meson install -C build

    install -Dm644 LICENSE \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
